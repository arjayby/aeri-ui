{
	"name": "aeri-ui",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"test:catalog": "pnpm --filter web build && playwright test",
		"test:consumer": "tsx scripts/verify-consumer-project.ts",
		"test": "pnpm run test:catalog && pnpm run test:consumer",
		"dev:web": "turbo run dev -F web",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "pnpm run format:check && pnpm run lint && pnpm run check-types"
	},
	"dependencies": {
		"@aeri-ui/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aeri-ui/config": "workspace:*",
		"@playwright/test": "^1.62.0",
		"@biomejs/biome": "^2.5.2",
		"@types/node": "^22.13.14",
		"tsx": "^4.22.5",
		"turbo": "^2.10.2",
		"typescript": "catalog:",
		"vercel": "^54.18.6"
	},
	"packageManager": "pnpm@10.28.0"
}
