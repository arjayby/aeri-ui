{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"postinstall": "fumadocs-mdx",
		"prebuild": "pnpm --dir ../.. run registry:build",
		"dev": "next dev --port 3001",
		"build": "next build && node scripts/prepare-standalone.mjs",
		"start": "next start --port 3001",
		"check-types": "fumadocs-mdx && next typegen && tsc --noEmit",
		"format:check": "biome format .",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@aeri-ui/env": "workspace:*",
		"@aeri-ui/ui": "workspace:*",
		"@base-ui/react": "^1.6.0",
		"@swc/helpers": "^0.5.23",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "catalog:",
		"fumadocs-core": "16.12.1",
		"fumadocs-mdx": "15.2.0",
		"fumadocs-ui": "npm:@fumadocs/base-ui@16.12.1",
		"lucide-react": "catalog:",
		"next": "^16.2.0",
		"next-themes": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"sonner": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aeri-ui/config": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@types/node": "^20",
		"@types/mdx": "^2.0.14",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:"
	}
}
